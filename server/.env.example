# ============================================================
# MindVault LLM Proxy — конфигурация через переменные окружения
# Скопируй в .env и подставь свои значения (или экспортируй в окружение).
# ============================================================

# --- Основной LLM-провайдер (любой OpenAI-совместимый) ---

# API-ключ провайдера. Если не задан — сервер стартует, но все LLM-эндпоинты
# отвечают 503 llm_unavailable (клиент уходит в офлайн-fallback).
# Fallback: если LLM_API_KEY пуст, берётся GROQ_API_KEY.
LLM_API_KEY=

# Endpoint провайдера (Groq по умолчанию; можно OpenRouter, DeepSeek, OpenAI и т.д.)
LLM_BASE_URL=https://api.groq.com/openai/v1

# Таймаут запросов к LLM, секунды
LLM_TIMEOUT_SEC=30

# --- Per-feature модели ---

# Быстрая дешёвая модель: категоризация, тон, сводки, декомпозиция
LLM_MODEL_FAST=llama-3.1-8b-instant

# Сильная модель для чата-компаньона (нужна эмпатия и связность)
LLM_MODEL_COMPANION=llama-3.3-70b-versatile

# Запасная модель: если основная вернула ошибку (снята с обслуживания,
# model not found, rate-limit по модели) — автоматический ретрай на ней.
# При ошибках доступа (401/квота) ретрай не делается.
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Эмбеддинги ---
# У Groq эмбеддингов может не быть — можно указать отдельного провайдера
# (например OpenAI). Если эти переменные пусты — используются основные
# LLM_BASE_URL / LLM_API_KEY.

LLM_EMBED_MODEL=text-embedding-3-small
LLM_EMBED_BASE_URL=
LLM_EMBED_API_KEY=

# --- Сервер ---

# Разрешённые CORS-origins, через запятую. "*" — все (PWA на другом домене).
CORS_ORIGINS=*

# Лимит запросов в минуту на клиента (заголовок X-Client-Id, иначе IP).
# При превышении — HTTP 429.
RATE_LIMIT_PER_MIN=30

# Уровень логирования (DEBUG/INFO/WARNING). Пользовательские тексты
# не логируются ни на каком уровне.
LOG_LEVEL=INFO
